+ITEM_RE = re.compile(r'^- \[\[([^|]+?)\|.*\]\] ')   # 파일명에 [ ] 가 들어간다([한영자막]·[Tech he'Story]). | 는 없다
+ROLE_HEAD_RE = re.compile(r'^## \S+ (주제|도구|비교대상|관련)로 다룬 영상')
