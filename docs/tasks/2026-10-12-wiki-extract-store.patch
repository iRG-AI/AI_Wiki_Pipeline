+def tree_hash(root):
+    h = hashlib.sha256()
+    for d, _, fs in sorted(os.walk(root)):
+        for f in sorted(fs):
+            p = os.path.join(d, f)
+            h.update(p.encode()); h.update(open(p, 'rb').read())
+    return h.hexdigest()
+
