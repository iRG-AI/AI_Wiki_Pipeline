+      check('wiki-note → 200 · 본문', n1.status === 200 && JSON.parse(n1.body).body.includes('본문 첫 줄'), n1.body.toString());
+      check('wiki-note 잘못된 id → 400', (await get('/api/wiki-note?id=../../etc/passwd')).status === 400);
