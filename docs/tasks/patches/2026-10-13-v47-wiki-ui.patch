+  if (openId === id) { openId = null; return; }
+  openId = id;
+  row.classList.add('open'); row.setAttribute('aria-expanded', 'true');
+  row.insertAdjacentHTML('afterend', detailHtml(BY_ID.get(id)));
+}
+window.addEventListener('hashchange', () => { const before = S.q; readHash(); if (S.q !== before) runSearch(S.q); else apply(); });
+
+// ── 시작 ──
+(async () => {
+  readHash();
+  try {
