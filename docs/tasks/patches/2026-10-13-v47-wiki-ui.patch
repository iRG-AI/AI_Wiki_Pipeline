+  return top.map(({ i, score }) => ({ id: notes[i].id, score: Math.round(score * 1000) / 1000 }));
+}
+
+// (v4.7) 화면 오른쪽 미리보기용 노트 본문 — id 로만 찾는다(경로를 받지 않는다). 프론트매터는 뗀다
+function noteById(id) {
+  const { notes, byId } = loadIndex();
+  const i = byId.get(id);
+  if (i === undefined) return null;
+  const n = notes[i];
+  const text = readNote(n.path);
+  return { id: n.id, path: n.path, body: text.replace(/^---\n[\s\S]*?\n---\n/, '').trim() };
+}
+
+module.exports = { loadIndex, search, keywordSearch, readNote, ask, listTopics, listPayload, scoreAll, similar, noteById, ID_RE, isGeminiDisabled, VAULT };
