+
+    print('▶ 멱등성')
+    code, out, rj = run([f'--csv={csv_path}', '--apply', '--if-new'])
+    check('--if-new 같은 CSV 는 건너뜀', rj and rj.get('skipped') == 'already_processed', rj)
+    code, out, rj = run([f'--csv={csv_path}', '--apply', '--force'])
