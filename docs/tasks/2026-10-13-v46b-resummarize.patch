+  }],
+];
+
+(async () => {
+  let pass = 0;
+  for (const [name, fn] of cases) {
+    try { await fn(); pass++; out(`PASS  ${name}`); }
+    catch (e) { out(`FAIL  ${name}\n      → ${e.message}`); }
+  }
+  fs.rmSync(TMP, { recursive: true, force: true });
