{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(scripts/run_all_tests.sh*)",
      "Bash(/opt/homebrew/bin/node scripts/test_*)",
      "Bash(/opt/homebrew/bin/python3 scripts/test_*)",
      "Bash(/opt/homebrew/bin/python3 scripts/verify_library.py)",
      "Bash(/opt/homebrew/bin/python3 sheet_mirror.py --check)",
      "Bash(/opt/homebrew/bin/python3 sheet_mirror.py --dry-run)",
      "Bash(/opt/homebrew/bin/python3 sync_obsidian.py --dry-run*)",
      "Bash(/opt/homebrew/bin/python3 backup_library.py --status)",
      "Bash(plutil -lint *)",
      "Bash(launchctl list*)",
      "Bash(launchctl print *)",
      "Bash(shasum *)",
      "Read(~/Documents/Claude/XP/**)",
      "Write(~/Documents/Claude/XP/**)",
      "Edit(~/Documents/Claude/XP/**)",
      "Read(~/Library/Logs/irichgreen/**)",
      "Read(~/Library/LaunchAgents/**)"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(rm *library.db*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_run_window.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record_base.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate_subagent_stop.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "crossSessionInbound": "accept"
}
